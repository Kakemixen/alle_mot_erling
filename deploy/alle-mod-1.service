# Example systemd service: starts the quiz on boot and restarts it if it crashes.
# Assumes the code is in /opt/alle-mod-1 with its .venv, run as user "quiz".
#
#   sudo cp deploy/alle-mod-1.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now alle-mod-1
#   journalctl -u alle-mod-1 -f        # logs

[Unit]
Description=Alle mot Erling quiz
After=network.target

[Service]
User=quiz
WorkingDirectory=/opt/alle-mod-1
# Keep the database outside the code folder, so updating the code can't touch it.
Environment=QUIZ_DB=/var/lib/alle-mod-1/quiz.db
StateDirectory=alle-mod-1
Environment=PUBLIC_URL=https://quiz.example.com
# Environment=HOST_PASSWORD=something-else
ExecStart=/opt/alle-mod-1/.venv/bin/gunicorn -c gunicorn.conf.py app:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
